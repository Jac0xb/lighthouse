{
  "name": "lighthouse-sdk-legacy",
  "version": "3.0.0",
  "description": "Legacy Umi / web3.js v1 client for Lighthouse",
  "sideEffects": false,
  "module": "dist/src/index.mjs",
  "main": "dist/src/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/src/index.mjs",
      "require": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/**/*",
    "dist/types/**/*"
  ],
  "scripts": {
    "build": "rimraf dist && tsup && tsc -p ./tsconfig.declarations.json",
    "build:docs": "typedoc",
    "test": "tsx --test test/**/*.test.ts",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "format": "prettier --check src test",
    "format:fix": "prettier --write src test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "dependencies": {
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-serializers-core": "^1.6.0",
    "@solana/web3.js": "^1.99.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "eslint": "^10.15.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.74.0"
  },
  "pnpm": {
    "overrides": {
      "base-x": "^3.0.11"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
